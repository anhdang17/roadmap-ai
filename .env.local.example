# ═══════════════════════════════════════════════════════
# TURSO DATABASE
# ═══════════════════════════════════════════════════════
# Create at https://turso.tech
# CLI: turso db create goalplan-ai
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# ═══════════════════════════════════════════════════════
# CLERK AUTHENTICATION
# ═══════════════════════════════════════════════════════
# Get keys at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# ═══════════════════════════════════════════════════════
# GEMINI AI
# ═══════════════════════════════════════════════════════
# Get API key at https://aistudio.google.com/app/api-key
GEMINI_API_KEY=AIzaYourRealGeminiApiKeyHere

# ═══════════════════════════════════════════════════════
# APP URL
# ═══════════════════════════════════════════════════════
# Development: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════
# ADMIN EMAILS
# ═══════════════════════════════════════════════════════
# Comma-separated emails that get ADMIN role
ADMIN_EMAILS=admin@example.com
